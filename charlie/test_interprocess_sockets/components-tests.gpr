with "components.gpr";


project Components.Tests
is
   for Create_Missing_Dirs use "True";

   for Source_Dirs use ("source");

   for Main use ("test_interprocess_client_sockets.adb",
                 "test_interprocess_server_sockets.adb");

   for Object_Dir use "build";
   for Exec_Dir   use ".";


   package Compiler extends Components.Compiler
   is
      for Switches ("Ada") use
         Components.Compiler'Switches ("Ada") & ("-gnatwa", 
                                                 "-gnatwl",    -- elaboration warnings
                                                 "-gnatVa");   -- all validity checks;
   end Compiler; 
   
   package Binder   renames Components.Binder;
   package Builder  renames Components.Builder;
   package Linker   renames Components.Linker;

end Components.Tests;

