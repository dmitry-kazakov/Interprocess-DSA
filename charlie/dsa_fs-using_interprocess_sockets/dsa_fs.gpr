with "components";


project DSA_FS
is
   for Source_Dirs  use ("src");
   for Object_Dir   use "build";

   for Create_Missing_Dirs use "True";


   package Compiler
   is
      for Switches ("s-parint.adb") use ("-gnatg");
   end Compiler;


   package Binder
   is
      for Switches ("Ada") use ("-Es");   -- Symbolic traceback
   end Binder;

end DSA_FS;
