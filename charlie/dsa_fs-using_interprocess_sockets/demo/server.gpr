with "../dsa_fs";

project Server
is
   for Source_Dirs use ("both", "server");
   for Object_Dir  use "build/server";
   for Exec_Dir    use "bin";
   for Main        use ("server.adb");

   for Create_Missing_Dirs use "True";


   package Compiler 
   is
      for Switches ("api.adb") use ("-gnatzr");
   end Compiler;


   package Binder 
   is
      for Switches ("Ada") use ("-Es");         --  Symbolic traceback
   end Binder;

end Server;
